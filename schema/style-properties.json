{
  "groups": [
    { "key": "layout", "label": "Layout" },
    { "key": "child", "label": "Flex / grid child" },
    { "key": "spacing", "label": "Spacing" },
    { "key": "size", "label": "Size" },
    { "key": "position", "label": "Position" },
    { "key": "typography", "label": "Typography" },
    { "key": "background", "label": "Background" },
    { "key": "border", "label": "Border" },
    { "key": "effects", "label": "Effects" }
  ],
  "properties": [
    { "key": "display", "prop": "display", "type": "keyword", "group": "layout", "label": "Display", "options": ["block", "flex", "grid", "inline", "inline-block", "inline-flex", "inline-grid", "contents", "none"] },
    { "key": "flexDirection", "prop": "flex-direction", "type": "keyword", "group": "layout", "label": "Direction", "options": ["row", "row-reverse", "column", "column-reverse"], "when": { "display": ["flex", "inline-flex"] } },
    { "key": "flexWrap", "prop": "flex-wrap", "type": "keyword", "group": "layout", "label": "Wrap", "options": ["nowrap", "wrap", "wrap-reverse"], "when": { "display": ["flex", "inline-flex"] } },
    { "key": "gridTemplateColumns", "prop": "grid-template-columns", "type": "string", "group": "layout", "label": "Grid columns", "placeholder": "repeat(3, minmax(0, 1fr))", "when": { "display": ["grid", "inline-grid"] } },
    { "key": "gridTemplateRows", "prop": "grid-template-rows", "type": "string", "group": "layout", "label": "Grid rows", "when": { "display": ["grid", "inline-grid"] } },
    { "key": "justifyContent", "prop": "justify-content", "type": "keyword", "group": "layout", "label": "Justify content", "options": ["flex-start", "center", "flex-end", "space-between", "space-around", "space-evenly", "stretch", "start", "end"], "when": { "display": ["flex", "inline-flex", "grid", "inline-grid"] } },
    { "key": "alignItems", "prop": "align-items", "type": "keyword", "group": "layout", "label": "Align items", "options": ["stretch", "flex-start", "center", "flex-end", "baseline", "start", "end"], "when": { "display": ["flex", "inline-flex", "grid", "inline-grid"] } },
    { "key": "alignContent", "prop": "align-content", "type": "keyword", "group": "layout", "label": "Align content", "options": ["stretch", "flex-start", "center", "flex-end", "space-between", "space-around", "start", "end"], "when": { "display": ["flex", "inline-flex", "grid", "inline-grid"] } },
    { "key": "gap", "prop": "gap", "type": "length", "group": "layout", "label": "Gap", "when": { "display": ["flex", "inline-flex", "grid", "inline-grid"] } },
    { "key": "rowGap", "prop": "row-gap", "type": "length", "group": "layout", "label": "Row gap", "when": { "display": ["flex", "inline-flex", "grid", "inline-grid"] } },
    { "key": "columnGap", "prop": "column-gap", "type": "length", "group": "layout", "label": "Column gap", "when": { "display": ["flex", "inline-flex", "grid", "inline-grid"] } },

    { "key": "alignSelf", "prop": "align-self", "type": "keyword", "group": "child", "label": "Align self", "options": ["auto", "stretch", "flex-start", "center", "flex-end", "baseline", "start", "end"] },
    { "key": "flexGrow", "prop": "flex-grow", "type": "number", "group": "child", "label": "Grow" },
    { "key": "flexShrink", "prop": "flex-shrink", "type": "number", "group": "child", "label": "Shrink" },
    { "key": "flexBasis", "prop": "flex-basis", "type": "length", "group": "child", "label": "Basis" },
    { "key": "order", "prop": "order", "type": "number", "group": "child", "label": "Order" },
    { "key": "gridColumn", "prop": "grid-column", "type": "string", "group": "child", "label": "Grid column", "placeholder": "span 2" },
    { "key": "gridRow", "prop": "grid-row", "type": "string", "group": "child", "label": "Grid row" },

    { "key": "paddingTop", "prop": "padding-top", "type": "length", "group": "spacing", "label": "Padding top", "box": "padding" },
    { "key": "paddingRight", "prop": "padding-right", "type": "length", "group": "spacing", "label": "Padding right", "box": "padding" },
    { "key": "paddingBottom", "prop": "padding-bottom", "type": "length", "group": "spacing", "label": "Padding bottom", "box": "padding" },
    { "key": "paddingLeft", "prop": "padding-left", "type": "length", "group": "spacing", "label": "Padding left", "box": "padding" },
    { "key": "marginTop", "prop": "margin-top", "type": "length", "group": "spacing", "label": "Margin top", "box": "margin" },
    { "key": "marginRight", "prop": "margin-right", "type": "length", "group": "spacing", "label": "Margin right", "box": "margin" },
    { "key": "marginBottom", "prop": "margin-bottom", "type": "length", "group": "spacing", "label": "Margin bottom", "box": "margin" },
    { "key": "marginLeft", "prop": "margin-left", "type": "length", "group": "spacing", "label": "Margin left", "box": "margin" },

    { "key": "width", "prop": "width", "type": "length", "group": "size", "label": "Width" },
    { "key": "minWidth", "prop": "min-width", "type": "length", "group": "size", "label": "Min width" },
    { "key": "maxWidth", "prop": "max-width", "type": "length", "group": "size", "label": "Max width" },
    { "key": "height", "prop": "height", "type": "length", "group": "size", "label": "Height" },
    { "key": "minHeight", "prop": "min-height", "type": "length", "group": "size", "label": "Min height" },
    { "key": "maxHeight", "prop": "max-height", "type": "length", "group": "size", "label": "Max height" },
    { "key": "aspectRatio", "prop": "aspect-ratio", "type": "string", "group": "size", "label": "Aspect ratio", "placeholder": "16 / 9" },
    { "key": "objectFit", "prop": "object-fit", "type": "keyword", "group": "size", "label": "Object fit", "options": ["fill", "contain", "cover", "none", "scale-down"] },
    { "key": "overflow", "prop": "overflow", "type": "keyword", "group": "size", "label": "Overflow", "options": ["visible", "hidden", "clip", "scroll", "auto"] },

    { "key": "position", "prop": "position", "type": "keyword", "group": "position", "label": "Position", "options": ["static", "relative", "absolute", "fixed", "sticky"] },
    { "key": "top", "prop": "top", "type": "length", "group": "position", "label": "Top" },
    { "key": "right", "prop": "right", "type": "length", "group": "position", "label": "Right" },
    { "key": "bottom", "prop": "bottom", "type": "length", "group": "position", "label": "Bottom" },
    { "key": "left", "prop": "left", "type": "length", "group": "position", "label": "Left" },
    { "key": "zIndex", "prop": "z-index", "type": "number", "group": "position", "label": "Z-index" },

    { "key": "fontFamily", "prop": "font-family", "type": "string", "group": "typography", "label": "Font family" },
    { "key": "fontSize", "prop": "font-size", "type": "length", "group": "typography", "label": "Font size" },
    { "key": "fontWeight", "prop": "font-weight", "type": "keyword", "group": "typography", "label": "Font weight", "options": ["100", "200", "300", "400", "500", "600", "700", "800", "900", "normal", "bold"] },
    { "key": "fontStyle", "prop": "font-style", "type": "keyword", "group": "typography", "label": "Font style", "options": ["normal", "italic"] },
    { "key": "lineHeight", "prop": "line-height", "type": "length", "unitless": true, "group": "typography", "label": "Line height" },
    { "key": "letterSpacing", "prop": "letter-spacing", "type": "length", "group": "typography", "label": "Letter spacing" },
    { "key": "color", "prop": "color", "type": "color", "group": "typography", "label": "Text color" },
    { "key": "textAlign", "prop": "text-align", "type": "keyword", "group": "typography", "label": "Text align", "options": ["left", "center", "right", "justify", "start", "end"] },
    { "key": "textTransform", "prop": "text-transform", "type": "keyword", "group": "typography", "label": "Transform", "options": ["none", "uppercase", "lowercase", "capitalize"] },
    { "key": "textDecoration", "prop": "text-decoration", "type": "keyword", "group": "typography", "label": "Decoration", "options": ["none", "underline", "line-through", "overline"] },
    { "key": "whiteSpace", "prop": "white-space", "type": "keyword", "group": "typography", "label": "White space", "options": ["normal", "nowrap", "pre", "pre-wrap", "pre-line", "balance"] },

    { "key": "backgroundColor", "prop": "background-color", "type": "color", "group": "background", "label": "Background color" },
    { "key": "backgroundImage", "prop": "background-image", "type": "url", "group": "background", "label": "Background image" },
    { "key": "backgroundGradient", "prop": "background-image", "type": "string", "group": "background", "label": "Gradient (overrides image)", "placeholder": "linear-gradient(180deg, #000, #333)" },
    { "key": "backgroundSize", "prop": "background-size", "type": "keyword", "group": "background", "label": "Size", "options": ["auto", "cover", "contain"] },
    { "key": "backgroundPosition", "prop": "background-position", "type": "string", "group": "background", "label": "Position", "placeholder": "center center" },
    { "key": "backgroundRepeat", "prop": "background-repeat", "type": "keyword", "group": "background", "label": "Repeat", "options": ["repeat", "no-repeat", "repeat-x", "repeat-y"] },

    { "key": "borderWidth", "prop": "border-width", "type": "length", "group": "border", "label": "Width" },
    { "key": "borderStyle", "prop": "border-style", "type": "keyword", "group": "border", "label": "Style", "options": ["none", "solid", "dashed", "dotted", "double"] },
    { "key": "borderColor", "prop": "border-color", "type": "color", "group": "border", "label": "Color" },
    { "key": "borderRadius", "prop": "border-radius", "type": "length", "group": "border", "label": "Radius" },

    { "key": "opacity", "prop": "opacity", "type": "number", "group": "effects", "label": "Opacity" },
    { "key": "boxShadow", "prop": "box-shadow", "type": "string", "group": "effects", "label": "Box shadow", "placeholder": "0 4px 12px rgba(0,0,0,.15)" },
    { "key": "transform", "prop": "transform", "type": "string", "group": "effects", "label": "Transform", "placeholder": "translateY(-2px)" },
    { "key": "transition", "prop": "transition", "type": "string", "group": "effects", "label": "Transition", "placeholder": "all .2s ease" },
    { "key": "cursor", "prop": "cursor", "type": "keyword", "group": "effects", "label": "Cursor", "options": ["auto", "pointer", "default", "text", "not-allowed", "grab"] }
  ]
}
