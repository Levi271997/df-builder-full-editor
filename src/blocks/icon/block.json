{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "dfb/icon",
	"version": "0.1.0",
	"title": "Icon",
	"category": "dfb",
	"icon": "star-filled",
	"description": "SVG icon; size via font-size, color via text color.",
	"textdomain": "df-builder",
	"usesContext": [
		"postId",
		"postType"
	],
	"supports": {
		"html": false,
		"anchor": true,
		"className": true
	},
	"attributes": {
		"dfb": {
			"type": "object"
		},
		"icon": {
			"type": "string",
			"default": "arrow-right"
		},
		"label": {
			"type": "string",
			"default": ""
		}
	},
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
