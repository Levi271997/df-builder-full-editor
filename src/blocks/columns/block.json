{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "dfb/columns",
	"version": "0.1.0",
	"title": "Grid Columns",
	"category": "dfb",
	"icon": "columns",
	"description": "Responsive CSS-grid columns.",
	"textdomain": "df-builder",
	"usesContext": [
		"postId",
		"postType"
	],
	"supports": {
		"html": false,
		"anchor": true,
		"className": true
	},
	"attributes": {
		"dfb": {
			"type": "object"
		},
		"columns": {
			"type": "number",
			"default": 2
		},
		"stackOn": {
			"type": "string",
			"default": "landscape"
		}
	},
	"keywords": [
		"grid",
		"columns",
		"layout"
	],
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
