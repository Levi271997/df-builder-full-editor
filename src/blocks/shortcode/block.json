{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "dfb/shortcode",
	"version": "0.2.0",
	"title": "Shortcode",
	"category": "dfb",
	"icon": "shortcode",
	"description": "Runs a WordPress shortcode, e.g. a form plugin.",
	"textdomain": "df-builder",
	"usesContext": [
		"postId",
		"postType"
	],
	"supports": {
		"html": false,
		"anchor": true,
		"className": true
	},
	"attributes": {
		"dfb": {
			"type": "object"
		},
		"text": {
			"type": "string",
			"default": ""
		}
	},
	"keywords": [
		"shortcode",
		"form",
		"embed"
	],
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
